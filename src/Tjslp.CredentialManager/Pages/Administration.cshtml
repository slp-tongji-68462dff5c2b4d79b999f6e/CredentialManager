@page "/administration"
@using Tjslp.CredentialManager.Services
@model Tjslp.CredentialManager.Pages.AdministrationModel
@{
    ViewData["Title"] = "凭证管理（管理员）";
}
<!doctype html>
<html lang="zh">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <main>
        <h1>所有凭证</h1>
        <p>当前用户：<strong>@Model.Sub</strong>（管理员） · <a href="/">管理我的凭证</a></p>

        @if (Model.Error is not null)
        {
            <div class="error">@Model.Error</div>
        }

        <h2>全部凭证（@Model.Credentials.Count）</h2>
        @if (Model.Credentials.Count == 0)
        {
            <p>暂无凭证。</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>别名</th>
                        <th>ID</th>
                        <th>归属人</th>
                        <th>过期时间</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var credential in Model.Credentials)
                    {
                        <tr>
                            <td>@credential.Alias</td>
                            <td><code>@credential.CredentialId</code></td>
                            <td>@credential.Owner</td>
                            <td>@(credential.Expire?.ToString("u") ?? "永久")</td>
                            <td>
                                <form method="post" asp-page-handler="Revoke" onsubmit="return confirm('确认吊销该凭证？');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@credential.CredentialId" />
                                    <button type="submit" class="danger">吊销</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h2>同步下游</h2>
        <form method="post" asp-page-handler="Sync">
            @Html.AntiForgeryToken()
            <button type="submit">同步</button>
        </form>
    </main>
</body>
</html>
